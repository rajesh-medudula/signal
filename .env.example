# Copy this file to .env.local and fill in real values.
# .env.local (and every other .env* variant except this file) is
# git-ignored — never commit real secrets.

# --- Supabase -----------------------------------------------------------
# Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Grants full database access — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI provider ----------------------------------------------------------
# Placeholder for whichever provider is wired up in a future module.
AI_PROVIDER_API_KEY=your-ai-provider-api-key

# --- Gmail channel (Google OAuth) ----------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/channels/gmail/callback
